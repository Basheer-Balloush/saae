# Worker runtime. Copy to .dev.vars locally; never commit credentials.
SUPABASE_URL=https://zkpuyhrmyslmstzwojvw.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_ORGANIZATION_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ORGANIZATION_SERVICE_ROLE_KEY
SITE_URL=https://REPLACE_STAGING_WORKER.workers.dev
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM="SAAE <noreply@aisyria.org>"
TEST_EMAIL_ALLOWLIST=
RESEND_API_KEY=
# Website chat: set GEMINI_API_KEY (Google AI Studio) or OPENROUTER_API_KEY.
# Gemini wins when both are set. CHAT_MODEL names the model for the key in use:
# "gemini-3.8-flash" for Google, "google/gemini-3.8-flash" for OpenRouter.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CHAT_MODEL=gemini-3.8-flash
# Admin knowledge base embeddings (text-embedding-3-small, 1536 dimensions).
OPENAI_API_KEY=
AUTH_RATE_LIMIT_PEPPER=REPLACE_RANDOM_SERVER_SECRET
EMAIL_PREVIEW_SECRET=
QUEUE_PROCESS_SECRET=
ENABLE_TRAINER_OUTBOX=false
ENABLE_EMAIL_QUEUES=false
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_WEBHOOK_SECRET=
